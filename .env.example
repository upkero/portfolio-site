# Server-side only: read by the /live bridge (vite.config.js in dev/preview, server.mjs in production).
# None of these are prefixed VITE_, so none of them ever reach the browser bundle.

# Where the five services listen (defaults match the portfolio port map)
OPS_CORE_URL=http://127.0.0.1:8000
RAG_CHAT_URL=http://127.0.0.1:8001
SALES_AGENT_URL=http://127.0.0.1:8002
MCP_AGENT_URL=http://127.0.0.1:8003
VOICE_AGENT_URL=http://127.0.0.1:8080

# The key each service requires (its SECURITY_API_KEY), sent as X-API-Key.
# The voice service takes no key. All four start as the portfolio's shared placeholder.
OPS_CORE_API_KEY=change-me-min-16-chars
RAG_CHAT_API_KEY=change-me-min-16-chars
SALES_AGENT_API_KEY=change-me-min-16-chars
MCP_AGENT_API_KEY=change-me-min-16-chars

# Set to 1 only behind a reverse proxy that appends the client IP to X-Forwarded-For (nginx, Caddy):
# the bridge rate-limits per client IP and otherwise sees only the proxy.
TRUST_PROXY=
